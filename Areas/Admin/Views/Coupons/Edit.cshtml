@model Coupon
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New coupon" : "Edit coupon";
}
<partial name="_AdminNav" />
<div class="row justify-content-center mt-3">
    <div class="col-lg-7">
        <div class="panel">
            <a asp-action="Index" class="small"><i class="bi bi-chevron-left"></i> Coupons</a>
            <h1 class="h4">@ViewData["Title"]</h1>
            <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control text-uppercase" placeholder="e.g. SALE20" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" placeholder="Shown to you only" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PercentOff" class="form-label"></label>
                        <div class="input-group"><input asp-for="PercentOff" class="form-control" /><span class="input-group-text">%</span></div>
                        <span asp-validation-for="PercentOff" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AmountOff" class="form-label">Or amount off</label>
                        <div class="input-group"><span class="input-group-text">@ViewHelpers.CurrencySymbol</span><input asp-for="AmountOff" class="form-control" /></div>
                        <span asp-validation-for="AmountOff" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MinSubtotal" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">@ViewHelpers.CurrencySymbol</span><input asp-for="MinSubtotal" class="form-control" /></div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MaxUses" class="form-label"></label>
                        <input asp-for="MaxUses" class="form-control" placeholder="Unlimited" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExpiresAt" class="form-label"></label>
                        <input asp-for="ExpiresAt" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="Active" class="form-check-input" />
                            <label asp-for="Active" class="form-check-label">Active</label>
                        </div>
                    </div>
                </div>
                @if (!isNew)
                {
                    <p class="small text-secondary mt-3 mb-0">Used @Model.UsedCount time(s).</p>
                }
                <button class="btn btn-buy mt-3" type="submit">@(isNew ? "Create coupon" : "Save")</button>
            </form>
        </div>
    </div>
</div>
