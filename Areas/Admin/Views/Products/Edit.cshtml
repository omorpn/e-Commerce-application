@model ProductFormViewModel
@{
    var isNew = Model.ProductCode == null;
    ViewData["Title"] = isNew ? "Add product" : "Edit product";
}
<partial name="_AdminNav" />
<div class="row justify-content-center mt-3">
    <div class="col-lg-8">
        <div class="panel">
            <a asp-action="Index" class="small"><i class="bi bi-chevron-left"></i> Products</a>
            <h1 class="h4">@ViewData["Title"]</h1>
            <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.ProductCode" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" asp-items="@(new SelectList(Catalog.ProductCategories))" class="form-select">
                            <option value="">Choose...</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group"><span class="input-group-text">$</span><input asp-for="Price" class="form-control" step="0.01" min="0.01" /></div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Stock" class="form-label"></label>
                        <input asp-for="Stock" class="form-control" min="0" />
                        <span asp-validation-for="Stock" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Image" class="form-label"></label>
                    <input asp-for="Image" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                    @if (Model.HasImage)
                    {
                        <div class="d-flex align-items-center gap-3 mt-2">
                            <img src="/Media/Image/@Model.ProductCode?v=@DateTime.UtcNow.Ticks" alt="Current image" class="rounded border" style="height:64px" />
                            <div class="form-check">
                                <input asp-for="RemoveImage" class="form-check-input" />
                                <label asp-for="RemoveImage" class="form-check-label"></label>
                            </div>
                        </div>
                    }
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Published" class="form-check-input" />
                    <label asp-for="Published" class="form-check-label"></label>
                </div>
                <button class="btn btn-buy" type="submit">@(isNew ? "Create product" : "Save changes")</button>
                <a class="btn btn-light border" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
