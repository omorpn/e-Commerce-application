@model List<Product>
@{
    ViewData["Title"] = "Manage products";
}
<partial name="_AdminNav" />
<div class="panel mt-3">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0">Products</h1>
        <form method="get" class="d-flex gap-2">
            <input name="q" value="@ViewData["q"]" class="form-control form-control-sm" placeholder="Search products" />
            <select name="category" class="form-select form-select-sm" asp-items="@(new SelectList(Catalog.ProductCategories, ViewData["category"]))">
                <option value="">All categories</option>
            </select>
            <button class="btn btn-light border btn-sm">Filter</button>
        </form>
        <a class="btn btn-buy btn-sm" asp-action="Create"><i class="bi bi-plus-lg"></i> Add product</a>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th style="width:56px"></th><th>Name</th><th>Category</th><th class="text-end">Price</th><th class="text-end">Stock</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><div class="mini-cover"><partial name="_ProductImage" model="p" /></div></td>
                        <td><a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductCode">@p.Name</a><div class="small text-secondary">#@p.ProductCode</div></td>
                        <td>@p.Category</td>
                        <td class="text-end">@ViewHelpers.Currency(p.Price)</td>
                        <td class="text-end @(p.Stock <= 5 ? "text-danger fw-semibold" : "")">@p.Stock</td>
                        <td><span class="badge @ViewHelpers.ListingBadge(p.Status)">@p.Status</span></td>
                        <td class="text-end">
                            <a class="btn btn-light border btn-sm" asp-action="Edit" asp-route-id="@p.ProductCode">Edit</a>
                            <form asp-action="Delete" asp-route-id="@p.ProductCode" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-secondary">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
