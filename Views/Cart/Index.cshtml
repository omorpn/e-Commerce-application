@model CartViewModel
@inject Microsoft.Extensions.Options.IOptions<ShippingOptions> ShippingSettings
@{
    ViewData["Title"] = "Shopping Cart";
    var freeOver = ShippingSettings.Value.FreeShippingOver;
}
<div class="row g-4 mt-1">
    <div class="col-lg-9">
        <div class="panel">
            <h1 class="h3">Shopping Cart</h1>
            @if (Model.IsEmpty)
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x display-4 text-secondary"></i>
                    <h2 class="h5 mt-3">Your cart is empty</h2>
                    <p class="text-secondary">Browse products and ebooks and add something you like.</p>
                    <a class="btn btn-cart" asp-controller="Products" asp-action="Index">Continue shopping</a>
                </div>
            }
            else
            {
                <div class="text-end small text-secondary border-bottom pb-1">Price</div>
                @foreach (var line in Model.Lines)
                {
                    var p = line.Product;
                    <div class="cart-line" data-testid="cart-line">
                        <a class="cart-thumb" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductCode">
                            <partial name="_ProductImage" model="p" />
                        </a>
                        <div class="flex-grow-1">
                            <a class="fw-semibold text-body" asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductCode">@p.Name</a>
                            @if (p.IsEbook)
                            {
                                <div class="small text-secondary">eBook by @p.AuthorName · Instant download</div>
                            }
                            else if (p.IsDownloadable)
                            {
                                <div class="small text-secondary">Digital download · Instant delivery</div>
                            }
                            else if (p.IsService && line.Problem == null)
                            {
                                <div class="small text-secondary"><i class="bi bi-calendar-check"></i> Service · @ViewHelpers.Duration(p.DurationMinutes) · choose your date at checkout</div>
                            }
                            else if (line.Problem == null)
                            {
                                <div class="small text-success">In Stock</div>
                            }
                            @if (line.Problem != null)
                            {
                                <div class="small text-danger fw-semibold"><i class="bi bi-exclamation-circle"></i> @line.Problem</div>
                            }
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                                @if (!p.IsDownloadable && (p.IsService || p.Stock > 0))
                                {
                                    <form asp-action="Update" method="post" class="d-flex align-items-center gap-1">
                                        <input type="hidden" name="productCode" value="@p.ProductCode" />
                                        <label class="small" for="qty-@p.ProductCode">Qty:</label>
                                        <select id="qty-@p.ProductCode" name="quantity" class="form-select form-select-sm qty-select" onchange="this.form.submit()">
                                            @for (var i = 1; i <= (p.IsService ? OrderService.MaxServiceQuantity : Math.Min(Math.Max(p.Stock, line.Quantity), CartService.MaxQuantityPerLine)); i++)
                                            {
                                                <option value="@i" selected="@(i == line.Quantity)">@i</option>
                                            }
                                        </select>
                                        <noscript><button class="btn btn-sm btn-light border">Update</button></noscript>
                                    </form>
                                    <span class="text-secondary">|</span>
                                }
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productCode" value="@p.ProductCode" />
                                    <button class="btn btn-link btn-sm p-0" type="submit">Delete</button>
                                </form>
                            </div>
                        </div>
                        <div class="fw-bold text-nowrap">@ViewHelpers.Price(line.LineTotal)</div>
                    </div>
                }
                <div class="text-end fs-5 mt-2">
                    Subtotal (@Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s")): <strong>@ViewHelpers.Currency(Model.Subtotal)</strong>
                </div>
            }
        </div>
    </div>
    @if (!Model.IsEmpty)
    {
        <div class="col-lg-3">
            <div class="panel order-summary">
                @if (Model.HasPhysical && freeOver > 0)
                {
                    if (Model.Subtotal >= freeOver)
                    {
                        <div class="small text-success mb-2"><i class="bi bi-check-circle-fill"></i> Your order qualifies for <strong>FREE delivery</strong>.</div>
                    }
                    else
                    {
                        <div class="small mb-1">Add <strong>@ViewHelpers.Currency(freeOver - Model.Subtotal)</strong> more for free delivery</div>
                        <div class="progress mb-3" style="height: 6px" role="progressbar" aria-label="Progress to free delivery">
                            <div class="progress-bar bg-success" style="width: @((int)Math.Min(100, Model.Subtotal / freeOver * 100))%"></div>
                        </div>
                    }
                }
                <div class="d-flex justify-content-between"><span>Subtotal (@Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s"))</span><strong>@ViewHelpers.Currency(Model.Subtotal)</strong></div>
                @if (Model.Coupon != null)
                {
                    <div class="d-flex justify-content-between text-success"><span>Coupon @Model.Coupon.Code</span><strong>-@ViewHelpers.Currency(Model.Discount)</strong></div>
                }
                @if (Model.HasPhysical)
                {
                    <div class="d-flex justify-content-between small text-secondary"><span>Delivery</span><span>At checkout</span></div>
                }
                <hr />
                <div class="d-flex justify-content-between fs-5 mb-3"><span>Total</span><strong>@ViewHelpers.Currency(Model.Subtotal - Model.Discount)</strong></div>
                @if (Model.HasProblems)
                {
                    <div class="alert alert-warning small">Remove or fix the highlighted items to continue.</div>
                    <button class="btn btn-buy w-100" disabled>Checkout</button>
                }
                else
                {
                    <a class="btn btn-buy w-100" asp-controller="Checkout" asp-action="Index" data-testid="checkout">Checkout (@ViewHelpers.Currency(Model.Subtotal - Model.Discount))</a>
                }

                <hr />
                @if (Model.Coupon != null)
                {
                    <form asp-action="RemoveCoupon" method="post" class="small">
                        <i class="bi bi-ticket-perforated text-success"></i> <strong>@Model.Coupon.Code</strong> applied
                        <button class="btn btn-link btn-sm p-0 ms-1" type="submit">Remove</button>
                    </form>
                }
                else
                {
                    <form asp-action="ApplyCoupon" method="post">
                        <label class="small fw-semibold" for="coupon">Have a coupon?</label>
                        <div class="input-group input-group-sm">
                            <input id="coupon" name="code" class="form-control text-uppercase" placeholder="e.g. WELCOME10" maxlength="40" />
                            <button class="btn btn-dark" type="submit" data-testid="apply-coupon">Apply</button>
                        </div>
                        @if (Model.CouponError != null)
                        {
                            <div class="small text-danger mt-1">@Model.CouponError</div>
                        }
                    </form>
                }
                <div class="small text-secondary mt-3"><i class="bi bi-shield-lock"></i> Secure checkout · <i class="bi bi-arrow-repeat"></i> Easy returns</div>
            </div>
        </div>
    }
</div>
