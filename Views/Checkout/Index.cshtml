@model CheckoutViewModel
@inject Microsoft.Extensions.Options.IOptions<ShippingOptions> ShippingSettings
@{
    ViewData["Title"] = "Checkout";
    var cart = Model.Cart;
    var shipping = ShippingSettings.Value;
    var fees = ShippingOptions.NigerianStates.ToDictionary(s => s, s => shipping.FeeFor(s, cart.Subtotal));
    var step = 1;
}
<h1 class="h3 mt-3">Checkout <span class="text-secondary fs-6">(@cart.ItemCount item@(cart.ItemCount == 1 ? "" : "s"))</span></h1>
<form asp-action="Index" method="post" class="row g-4" novalidate id="checkout-form"
      data-fees='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(fees))' data-default-fee="@shipping.FeeFor(null, cart.Subtotal).ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-subtotal="@cart.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-discount="@cart.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-physical="@(cart.HasPhysical ? "true" : "false")" data-currency="@ViewHelpers.CurrencySymbol">
    <div class="col-lg-8">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small empty-hidden"></div>

        <div class="panel mb-3">
            <h2 class="h5"><span class="step">@step</span> Contact details</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" placeholder="e.g. 0803 123 4567" />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>
        </div>

        @if (cart.HasServices)
        {
            step++;
            <div class="panel mb-3">
                <h2 class="h5"><span class="step">@step</span> Schedule your services</h2>
                @for (var i = 0; i < Model.Bookings.Count; i++)
                {
                    var booking = Model.Bookings[i];
                    var service = cart.Lines.First(l => l.Product.ProductCode == booking.ProductCode).Product;
                    <div class="booking border-top pt-3 mt-2" data-testid="booking">
                        <div class="fw-semibold">@service.Name</div>
                        <div class="small text-secondary mb-2">@ViewHelpers.Duration(service.DurationMinutes) · @Catalog.LocationLabel(service.ServiceLocation)</div>
                        <input type="hidden" name="Bookings[@i].ProductCode" value="@booking.ProductCode" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label small" for="booking-date-@i">Preferred date</label>
                                <input type="date" id="booking-date-@i" name="Bookings[@i].Date" value="@booking.Date?.ToString("yyyy-MM-dd")"
                                       min="@OrderService.EarliestServiceDate.ToString("yyyy-MM-dd")" class="form-control" required />
                                <span class="text-danger small" asp-validation-for="Bookings[i].Date"></span>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small" for="booking-notes-@i">Notes for the provider <span class="text-secondary">(optional)</span></label>
                                <input id="booking-notes-@i" name="Bookings[@i].Notes" value="@booking.Notes" maxlength="1000" class="form-control" placeholder="Preferred time, access details, what you need help with..." />
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (cart.NeedsAddress)
        {
            step++;
            <div class="panel mb-3">
                <h2 class="h5"><span class="step">@step</span> @(cart.HasPhysical ? "Delivery address" : "Service address")</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="AddressLine" class="form-label"></label>
                        <input asp-for="AddressLine" class="form-control" autocomplete="street-address" placeholder="House number, street, landmark" required />
                        <span asp-validation-for="AddressLine" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="State" class="form-label"></label>
                        <select asp-for="State" class="form-select" required data-state-select>
                            <option value="">Choose your state...</option>
                            @foreach (var state in ShippingOptions.NigerianStates)
                            {
                                <option value="@state">@state</option>
                            }
                        </select>
                        <span asp-validation-for="State" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" autocomplete="address-level2" required />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PostalCode" class="form-label">Postal code <span class="text-secondary">(optional)</span></label>
                        <input asp-for="PostalCode" class="form-control" autocomplete="postal-code" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Country" class="form-label"></label>
                        <input asp-for="Country" class="form-control" autocomplete="country-name" required />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                </div>
                @if (cart.HasPhysical)
                {
                    <div class="small text-secondary mt-2" data-eta><i class="bi bi-truck"></i> Delivery fee depends on your state.</div>
                }
            </div>
        }

        <div class="panel mb-3">
            <h2 class="h5"><span class="step">@(++step)</span> Payment method</h2>
            @for (var i = 0; i < Model.PaymentOptions.Count; i++)
            {
                var (value, label, help) = Model.PaymentOptions[i];
                var id = "pay-" + i;
                <label class="pay-option" for="@id">
                    <input class="form-check-input" type="radio" name="PaymentMethod" value="@value" id="@id" checked="@(Model.PaymentMethod == value)" />
                    <span>
                        <strong>@label</strong>
                        <small class="d-block text-secondary">@help</small>
                    </span>
                    @if (value == CheckoutPayment.Paystack)
                    {
                        <span class="pay-logos"><span class="pay-badge">VISA</span><span class="pay-badge">Verve</span><span class="pay-badge">Transfer</span></span>
                    }
                </label>
            }
            <span asp-validation-for="PaymentMethod" class="text-danger small"></span>
        </div>

        <div class="panel">
            <h2 class="h5"><span class="step">@(++step)</span> Review items</h2>
            @foreach (var line in cart.Lines)
            {
                <div class="cart-line compact">
                    <div class="cart-thumb"><partial name="_ProductImage" model="line.Product" /></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">@line.Product.Name</div>
                        <div class="small text-secondary">@(line.Product.IsDownloadable ? "Instant download to your library" : line.Product.IsService ? $"Sessions: {line.Quantity}" : $"Qty: {line.Quantity}")</div>
                    </div>
                    <div class="fw-bold">@ViewHelpers.Price(line.LineTotal)</div>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel order-summary">
            <h2 class="h5">Order Summary</h2>
            <div class="d-flex justify-content-between small"><span>Items:</span><span>@ViewHelpers.Currency(cart.Subtotal)</span></div>
            @if (cart.HasPhysical)
            {
                <div class="d-flex justify-content-between small"><span>Delivery:</span><span data-shipping>@(Model.State == null ? "Choose state" : Model.ShippingFee == 0 ? "FREE" : ViewHelpers.Currency(Model.ShippingFee))</span></div>
            }
            @if (cart.Coupon != null)
            {
                <div class="d-flex justify-content-between small text-success"><span>Coupon @cart.Coupon.Code:</span><span>-@ViewHelpers.Currency(cart.Discount)</span></div>
            }
            <hr />
            <div class="d-flex justify-content-between fs-5 fw-bold text-danger-emphasis"><span>Total:</span><span data-total>@ViewHelpers.Currency(Model.Total)</span></div>
            <button type="submit" class="btn btn-buy w-100 mt-3" data-testid="place-order">Place order</button>
            <p class="small text-secondary mt-3 mb-0"><i class="bi bi-shield-lock"></i> Your payment details are handled securely by our payment partner. By placing your order, you agree to our <a asp-controller="Home" asp-action="Privacy">terms</a>.</p>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
