@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mt-3">
    <h1 class="h3 mb-0">Notifications</h1>
    @if (Model.Any(n => !n.IsRead))
    {
        <form asp-action="MarkAllRead" method="post">
            <button class="btn btn-light border btn-sm" type="submit">Mark all as read</button>
        </form>
    }
</div>
<div class="panel mt-3 p-0">
    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-secondary"><i class="bi bi-bell display-6"></i><p class="mt-2">No notifications yet. Order updates and messages will show up here.</p></div>
    }
    @foreach (var n in Model)
    {
        <a class="notification @(n.IsRead ? "" : "unread")" asp-action="Open" asp-route-id="@n.Id">
            <i class="bi @(n.Title.Contains("message", StringComparison.OrdinalIgnoreCase) ? "bi-chat-dots" : n.Title.Contains("Payment") ? "bi-credit-card" : "bi-box-seam")"></i>
            <span class="flex-grow-1">
                <strong>@n.Title</strong>
                <span class="d-block small">@n.Message</span>
            </span>
            <small class="text-secondary text-nowrap">@ViewHelpers.TimeAgo(n.CreatedAt)</small>
        </a>
    }
</div>
