@model Order
@{
    ViewData["Title"] = $"Order #{Model.OrderNo}";
    var placed = ViewData["Placed"] as bool? == true && Model.Status != OrderStatus.AwaitingPayment;
    var canPayOnline = ViewData["CanPayOnline"] as bool? == true;
    var steps = new[] { OrderStatus.Pending, OrderStatus.Processing, OrderStatus.Shipped, OrderStatus.Delivered };
    var stepIndex = Array.IndexOf(steps, Model.Status);
}
@if (placed)
{
    <div class="panel border-success mt-3" data-testid="order-confirmation">
        <h1 class="h4 text-success"><i class="bi bi-check-circle-fill"></i> Order placed, thank you!</h1>
        <p class="mb-0">
            Your order number is <strong>#@Model.OrderNo</strong>.
            @if (Model.Products.Any(i => i.ProductType is ProductType.Ebook or ProductType.Digital))
            {
                <span>Your downloads are ready in <a asp-controller="Library" asp-action="Index">your library</a>.</span>
            }
            @if (Model.HasPhysicalItems)
            {
                <span>We'll let you know when your items ship.</span>
            }
            @if (Model.HasServiceItems)
            {
                <span>Your service providers have been notified of your booking.</span>
            }
        </p>
    </div>
}

@if (Model.Status == OrderStatus.AwaitingPayment)
{
    <div class="panel border-warning mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2" data-testid="awaiting-payment">
        <div>
            <h2 class="h5 mb-1"><i class="bi bi-hourglass-split text-warning"></i> Waiting for your payment</h2>
            <div class="small text-secondary">Complete the payment of <strong>@ViewHelpers.Currency(Model.InvoicePrice)</strong> to confirm this order. Unpaid orders are cancelled automatically after a while.</div>
        </div>
        @if (canPayOnline)
        {
            <form asp-action="Pay" asp-route-id="@Model.OrderNo" method="post">
                <button class="btn btn-buy" type="submit">Pay now</button>
            </form>
        }
    </div>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-chevron-left"></i> Your orders</a>
        <h1 class="h3 mb-0">Order details</h1>
        <div class="small text-secondary">Ordered on @Model.OrderDate.ToString("MMMM d, yyyy") · Order # @Model.OrderNo</div>
    </div>
    @if (OrderService.CustomerCanCancel(Model))
    {
        <form asp-action="Cancel" asp-route-id="@Model.OrderNo" method="post" onsubmit="return confirm('Cancel this order?');">
            <button class="btn btn-outline-danger btn-sm" type="submit">Cancel order</button>
        </form>
    }
</div>

<div class="panel mt-3">
    <div class="row g-3 small">
        @if (Model.AddressLine != null)
        {
            <div class="col-md-4">
                <h2 class="h6">@(Model.HasPhysicalItems ? "Shipping address" : "Service address")</h2>
                <div>@Model.CustomerName</div>
                <div>@Model.AddressLine</div>
                <div>@Model.City@(string.IsNullOrEmpty(Model.State) ? "" : ", " + Model.State) @Model.PostalCode</div>
                <div>@Model.Country</div>
            </div>
        }
        <div class="col-md-4">
            <h2 class="h6">Payment</h2>
            <div>@(Model.PaymentMethod ?? "-")</div>
            <span class="badge @(Model.PaymentStatus == PaymentStatus.Paid ? "text-bg-success" : "text-bg-light border")">@ViewHelpers.PaymentLabel(Model.PaymentStatus)</span>
        </div>
        <div class="col-md-4">
            <h2 class="h6">Order summary</h2>
            <div class="d-flex justify-content-between"><span>Item(s) subtotal:</span><span>@ViewHelpers.Currency(Model.Subtotal == 0 ? Model.InvoicePrice : Model.Subtotal)</span></div>
            @if (Model.HasPhysicalItems)
            {
                <div class="d-flex justify-content-between"><span>Delivery:</span><span>@(Model.ShippingFee == 0 ? "FREE" : ViewHelpers.Currency(Model.ShippingFee))</span></div>
            }
            @if (Model.Discount > 0)
            {
                <div class="d-flex justify-content-between text-success"><span>Coupon @Model.CouponCode:</span><span>-@ViewHelpers.Currency(Model.Discount)</span></div>
            }
            <div class="d-flex justify-content-between fw-bold"><span>Grand total:</span><span>@ViewHelpers.Currency(Model.InvoicePrice)</span></div>
        </div>
    </div>
</div>

<div class="panel mt-3">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h2 class="h5 mb-0">Status</h2>
        <span class="badge @ViewHelpers.StatusBadge(Model.Status)" data-testid="order-status">@ViewHelpers.StatusLabel(Model.Status)</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.TrackingNote))
    {
        <div class="alert alert-info small py-2"><i class="bi bi-info-circle"></i> @Model.TrackingNote</div>
    }
    @if (Model.HasPhysicalItems && Model.Status is not (OrderStatus.Cancelled or OrderStatus.AwaitingPayment))
    {
        <ol class="tracker">
            @for (var i = 0; i < steps.Length; i++)
            {
                <li class="@(i <= stepIndex ? "done" : "")">@steps[i]</li>
            }
        </ol>
    }
    @foreach (var item in Model.Products)
    {
        <div class="d-flex justify-content-between align-items-center border-top py-2">
            <div>
                <a class="fw-semibold" asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductCode">@item.ProductName</a>
                <div class="small text-secondary">
                    @switch (item.ProductType)
                    {
                        case ProductType.Ebook:
                        case ProductType.Digital:
                            <span>@Catalog.Label(item.ProductType)</span>
                            @if (Model.Status != OrderStatus.Cancelled)
                            {
                                <span>· <a asp-controller="Library" asp-action="Download" asp-route-id="@item.ProductCode">Download</a></span>
                            }
                            break;
                        case ProductType.Service:
                            <span>Service · @item.Quantity session@(item.Quantity == 1 ? "" : "s") on @item.ServiceDate?.ToString("dddd, MMMM d, yyyy")</span>
                            @if (!string.IsNullOrEmpty(item.ServiceNotes))
                            {
                                <div>Your notes: @item.ServiceNotes</div>
                            }
                            break;
                        default:
                            <span>Qty: @item.Quantity × @ViewHelpers.Currency(item.Price)</span>
                            break;
                    }
                    @if (Model.Status != OrderStatus.Cancelled && item.ProductType is ProductType.Physical or ProductType.Service)
                    {
                        <span class="ms-1 badge @(item.Fulfilled ? "text-bg-success" : "text-bg-light border")">
                            @(item.Fulfilled ? (item.ProductType == ProductType.Service ? "Completed" : "Shipped") : (item.ProductType == ProductType.Service ? "Booked" : "Preparing"))
                        </span>
                    }
                </div>
            </div>
            <div class="fw-bold">@ViewHelpers.Price(item.LineTotal)</div>
        </div>
    }
</div>

@if (Model.Events.Count > 0)
{
    <div class="panel mt-3">
        <h2 class="h5">Order history</h2>
        <ol class="timeline" data-testid="timeline">
            @foreach (var ev in Model.Events.OrderByDescending(e => e.CreatedAt).ThenByDescending(e => e.Id))
            {
                <li>
                    <div class="fw-semibold">@ev.Title</div>
                    @if (!string.IsNullOrEmpty(ev.Message))
                    {
                        <div class="small">@ev.Message</div>
                    }
                    <div class="small text-secondary">@ev.CreatedAt.ToString("MMM d, yyyy HH:mm") UTC</div>
                </li>
            }
        </ol>
    </div>
}
