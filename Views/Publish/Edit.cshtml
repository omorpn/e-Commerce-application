@model EbookFormViewModel
@inject Microsoft.Extensions.Options.IOptions<PublishingOptions> Publishing
@{
    var isNew = Model.ProductCode == null;
    ViewData["Title"] = isNew ? "Create a new ebook" : $"Edit {Model.Title}";
}
<div class="mt-3">
    <a asp-action="Index" class="small"><i class="bi bi-chevron-left"></i> Bookshelf</a>
    <h1 class="h3">@(isNew ? "Create a new ebook" : "Edit ebook")</h1>
    @if (Model.Status == ListingStatus.Blocked)
    {
        <div class="alert alert-danger small">This title was taken down by the store team: @Model.BlockedReason</div>
    }
</div>

<form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@Model.ProductCode" method="post" enctype="multipart/form-data" class="row g-4">
    <div class="col-lg-8">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small empty-hidden"></div>

        <div class="panel mb-3">
            <h2 class="h5">Ebook details</h2>
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Subtitle" class="form-label">Subtitle <span class="text-secondary">(optional)</span></label>
                <input asp-for="Subtitle" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="AuthorName" class="form-label"></label>
                <input asp-for="AuthorName" class="form-control" />
                <span asp-validation-for="AuthorName" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                <div class="form-text">This appears on your book's detail page. Hook the reader!</div>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Category" class="form-label">Genre</label>
                    <select asp-for="Category" asp-items="@(new SelectList(Catalog.EbookCategories))" class="form-select">
                        <option value="">Choose...</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Language" class="form-label"></label>
                    <select asp-for="Language" asp-items="@(new SelectList(Catalog.Languages))" class="form-select"></select>
                    <span asp-validation-for="Language" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="PageCount" class="form-label"></label>
                    <input asp-for="PageCount" class="form-control" />
                    <span asp-validation-for="PageCount" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="panel mb-3">
            <h2 class="h5">Content</h2>
            <div class="mb-3">
                <label asp-for="Manuscript" class="form-label"></label>
                <input asp-for="Manuscript" type="file" class="form-control" accept=".pdf,.epub,application/pdf,application/epub+zip" />
                @if (Model.ExistingFileName != null)
                {
                    <div class="form-text">Current file: <strong>@Model.ExistingFileName</strong>. Upload a new file to replace it.</div>
                }
                <span asp-validation-for="Manuscript" class="text-danger small"></span>
            </div>
            <div class="mb-1">
                <label asp-for="Cover" class="form-label"></label>
                <input asp-for="Cover" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-preview="#cover-preview" />
                <div class="form-text">@(Model.HasCover ? "Upload a new image to replace the current cover." : "No cover? We'll generate a clean typographic cover for you.") Ideal ratio 1.6:1 (e.g. 1600×2560).</div>
                <span asp-validation-for="Cover" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel mb-3">
            <h2 class="h5">Cover preview</h2>
            <div class="detail-media small-media" id="cover-preview">
                @if (Model.HasCover && Model.ProductCode.HasValue)
                {
                    <img src="/Media/Image/@Model.ProductCode?v=@DateTime.UtcNow.Ticks" alt="Current cover" class="product-img is-cover" />
                }
                else
                {
                    <div class="book-cover" style="--cover: linear-gradient(160deg, @ViewHelpers.CoverGradient(string.IsNullOrEmpty(Model.Title) ? "New book" : Model.Title))">
                        <span class="book-title">@(string.IsNullOrEmpty(Model.Title) ? "Your title" : Model.Title)</span>
                        <span class="book-author">@Model.AuthorName</span>
                    </div>
                }
            </div>
        </div>
        <div class="panel">
            <h2 class="h5">Pricing</h2>
            <label asp-for="Price" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">$</span>
                <input asp-for="Price" class="form-control" step="0.01" min="0" max="999.99" data-royalty-input />
            </div>
            <span asp-validation-for="Price" class="text-danger small"></span>
            <div class="form-text">Enter 0 to give your book away for free.</div>
            <div class="small mt-2">You earn about <strong data-royalty-output data-rate="@Publishing.Value.RoyaltyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)">$0.00</strong> per sale.</div>
            <hr />
            <div class="d-grid gap-2">
                @if (isNew || Model.Status == ListingStatus.Draft)
                {
                    <button class="btn btn-buy" type="submit" name="publishNow" value="true" data-testid="publish-now">Publish your ebook</button>
                    <button class="btn btn-light border" type="submit">Save as draft</button>
                }
                else
                {
                    <button class="btn btn-buy" type="submit">Save changes</button>
                }
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
