@model AuthorProfileViewModel
@{
    var isAuthor = User.IsInRole(Roles.Author);
    ViewData["Title"] = isAuthor ? "Author profile" : "Start self-publishing";
}
<div class="row justify-content-center mt-3">
    <div class="col-lg-8">
        @if (!isAuthor)
        {
            <div class="publish-header mb-3">
                <div>
                    <div class="small text-uppercase fw-semibold opacity-75">ShopNest Direct Publishing</div>
                    <h1 class="h3">Publish your ebook and reach readers everywhere</h1>
                    <p class="mb-0">Upload a PDF or EPUB, set your own price and earn royalties on every sale. It's free to publish.</p>
                </div>
            </div>
            <div class="row g-3 mb-3 text-center small">
                <div class="col-md-4"><div class="panel h-100"><i class="bi bi-cloud-upload fs-2 text-warning"></i><div class="fw-semibold">Upload</div>Your manuscript and cover</div></div>
                <div class="col-md-4"><div class="panel h-100"><i class="bi bi-tag fs-2 text-warning"></i><div class="fw-semibold">Set your price</div>Free or up to $999.99</div></div>
                <div class="col-md-4"><div class="panel h-100"><i class="bi bi-graph-up-arrow fs-2 text-warning"></i><div class="fw-semibold">Earn royalties</div>Track sales on your dashboard</div></div>
            </div>
        }
        <div class="panel">
            <h2 class="h5">@(isAuthor ? "Author profile" : "Set up your author profile")</h2>
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="mb-3">
                    <label asp-for="PenName" class="form-label"></label>
                    <input asp-for="PenName" class="form-control" />
                    <div class="form-text">The name readers will see on your books.</div>
                    <span asp-validation-for="PenName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="AuthorBio" class="form-label"></label>
                    <textarea asp-for="AuthorBio" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="AuthorBio" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="AcceptTerms" class="form-check-input" />
                    <label asp-for="AcceptTerms" class="form-check-label"></label>
                    <a asp-controller="Home" asp-action="Privacy" class="small ms-1">Publishing terms</a>
                    <div><span asp-validation-for="AcceptTerms" class="text-danger small"></span></div>
                </div>
                <button class="btn btn-buy" type="submit">@(isAuthor ? "Save profile" : "Become an author")</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
