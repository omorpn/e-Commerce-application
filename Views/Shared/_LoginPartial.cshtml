@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var name = user?.DisplayName ?? User.Identity?.Name?.Split('@')[0];
    <div class="dropdown">
        <a class="nav-tile dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" data-testid="account-menu">
            <small>Hello, @name</small>
            <strong>Account &amp; Lists</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow">
            <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i>Your orders</a></li>
            <li><a class="dropdown-item" asp-controller="Library" asp-action="Index"><i class="bi bi-book me-2"></i>Your library</a></li>
            <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="bi bi-heart me-2"></i>Your wish list</a></li>
            <li><a class="dropdown-item" asp-controller="Sell" asp-action="Index"><i class="bi bi-shop me-2"></i>Seller Central</a></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index"><i class="bi bi-person-gear me-2"></i>Account settings</a></li>
            @if (User.IsInRole(Roles.Admin))
            {
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin dashboard</a></li>
            }
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                </form>
            </li>
        </ul>
    </div>
    <a class="nav-tile d-none d-lg-flex" asp-controller="Orders" asp-action="Index">
        <small>Returns</small>
        <strong>&amp; Orders</strong>
    </a>
}
else
{
    <a class="nav-tile" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">
        <small>Hello, sign in</small>
        <strong>Account &amp; Lists</strong>
    </a>
    <a class="nav-tile d-none d-lg-flex" asp-area="Identity" asp-page="/Account/Register">
        <small>New customer?</small>
        <strong>Create account</strong>
    </a>
}
