@model Product
@if (Model.ImagePath != null)
{
    <img src="@ViewHelpers.ImageUrl(Model)" alt="@Model.Name" class="product-img @(Model.IsEbook ? "is-cover" : "")" loading="lazy" />
}
else if (Model.IsEbook)
{
    <div class="book-cover" style="--cover: linear-gradient(160deg, @ViewHelpers.CoverGradient(Model.Name))" aria-label="Cover of @Model.Name">
        <span class="book-title">@Model.Name</span>
        <span class="book-author">@Model.AuthorName</span>
    </div>
}
else
{
    <div class="product-placeholder type-@Model.Type.ToString().ToLowerInvariant()" aria-hidden="true"><i class="bi @ViewHelpers.CategoryIcon(Model.Category)"></i></div>
}
