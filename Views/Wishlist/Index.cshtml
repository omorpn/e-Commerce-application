@model List<ProductSummary>
@{
    ViewData["Title"] = "Your wish list";
}
<h1 class="h3 mt-3">Your wish list</h1>
@if (Model.Count == 0)
{
    <div class="panel text-center py-5">
        <i class="bi bi-heart display-5 text-secondary"></i>
        <h2 class="h5 mt-3">Your wish list is empty</h2>
        <p class="text-secondary">Tap <strong>Add to wish list</strong> on any product, service or download to save it for later.</p>
        <a class="btn btn-cart" asp-controller="Products" asp-action="Index">Start browsing</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <div class="d-flex flex-column gap-1">
                <partial name="_ProductCard" model="item" />
                <form asp-action="Toggle" method="post">
                    <input type="hidden" name="productCode" value="@item.Product.ProductCode" />
                    <button class="btn btn-link btn-sm p-0 text-danger" type="submit">Remove</button>
                </form>
            </div>
        }
    </div>
}
